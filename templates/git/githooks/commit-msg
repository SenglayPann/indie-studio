#!/bin/sh
# Indie Studio commit-msg hook: enforces the commit message convention.
# See indie-studio:git-workflow, references/commit-convention.md.
#
# Format:  <type>(<scope>): <summary>     e.g.  feat(inventory): add drag-drop slot swap
# Types:   feat fix perf refactor test docs build chore art audio level balance ui revert
#
# Emergency bypass (only when the human asks): STUDIO_SKIP_MSG_CHECK=1 git commit ...

[ "${STUDIO_SKIP_MSG_CHECK:-}" = "1" ] && exit 0

msg_file="$1"
subject=$(head -n 1 "$msg_file" | tr -d '\r')

# Messages git writes itself.
case "$subject" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *) exit 0 ;;
esac

types='feat|fix|perf|refactor|test|docs|build|chore|art|audio|level|balance|ui|revert'

if ! printf '%s' "$subject" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: .+"; then
  cat >&2 <<EOF
Commit message rejected.

  Your subject : $subject
  Expected     : <type>(<scope>): <summary>
  Types        : feat fix perf refactor test docs build chore art audio level balance ui revert
  Example      : feat(inventory): add drag-drop slot swap
  Example      : art(ui): add pressed state to buttons

Fix the message and commit again. (Details: indie-studio:git-workflow.)
EOF
  exit 1
fi

len=$(printf '%s' "$subject" | awk '{ print length($0) }')
if [ "$len" -gt 72 ]; then
  echo "Commit subject is $len characters; keep it to 72 or fewer." >&2
  exit 1
fi

second=$(sed -n '2p' "$msg_file" | tr -d '\r')
case "$second" in
  ''|'#'*) ;;
  *)
    echo "Leave a blank line between the subject and the body." >&2
    exit 1
    ;;
esac

exit 0
